{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Automated release PR generated by release-please. Merging this PR cuts a new release and promotes `:stable`.",
  "changelog-path": "CHANGELOG.md",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "CI/CD", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "openaudio",
      "components": ["go-openaudio", "pkg/etl"]
    }
  ],
  "packages": {
    ".": {
      "package-name": "go-openaudio",
      "component": "go-openaudio",
      "include-component-in-tag": false,
      "tag-separator": "",
      "extra-files": [
        { "type": "json", "path": "pkg/version/.version.json", "jsonpath": "$.version" }
      ]
    },
    "pkg/etl": {
      "package-name": "pkg/etl",
      "component": "pkg/etl",
      "include-component-in-tag": true,
      "tag-separator": "/",
      "extra-files": [
        { "type": "generic", "path": "go.mod" }
      ]
    }
  }
}
