NETWORK=dev
OPENAUDIO_ENV=dev
OPENAUDIO_TLS_SELF_SIGNED=true

OPENAUDIO_NODE_ENDPOINT=https://node4.oap.devnet
OPENAUDIO_DELEGATE_PRIVATE_KEY=1166189cdf129cdcb011f2ad0e5be24f967f7b7026d162d7c36073b12020b61c
OPENAUDIO_EXTERNAL_ADDRESS="openaudio-4:26656"
# Prune aggressively on the devnet. Without this the default retain height
# (604800 blocks) keeps every devnet block while non-archive compaction runs
# every block, which grew this node's blockstore+state.db to ~47GB.
OPENAUDIO_ARCHIVE=false
OPENAUDIO_RETAIN_HEIGHT=10
OPENAUDIO_STATE_SYNC_ENABLE=false

# Simulated location for devnet globe
OPENAUDIO_LATITUDE=-33.8688
OPENAUDIO_LONGITUDE=151.2093

# Waveforms: master switch only, to exercise the live-uploads-only state
OPENAUDIO_WAVEFORM_ENABLED=true
