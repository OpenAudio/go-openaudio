NETWORK=dev
OPENAUDIO_ENV=dev
OPENAUDIO_TLS_SELF_SIGNED=true

OPENAUDIO_NODE_ENDPOINT=https://node1.oap.devnet
OPENAUDIO_DELEGATE_PRIVATE_KEY=0xd09ba371c359f10f22ccda12fd26c598c7921bda3220c9942174562bc6a36fe8
OPENAUDIO_EXTERNAL_ADDRESS="openaudio-1:26656"
OPENAUDIO_ARCHIVE=true
OPENAUDIO_STATE_SYNC_SERVE_SNAPSHOTS=true
OPENAUDIO_STATE_SYNC_ENABLE=false

OPENAUDIO_GRPC_REFLECTION_ENABLED=true

# Enable ETL and Explorer functionality
OPENAUDIO_ETL_ENABLED=true
OPENAUDIO_EXPLORER_ENABLED=true

# Waveform analysis. Enabled on nodes 1 and 2 only; nodes 3 and 4 hold the
# same blobs with it off, which is what keeps the feature's opt-in behavior
# exercised in devnet.
OPENAUDIO_WAVEFORM_ENABLED=true
OPENAUDIO_WAVEFORM_BACKFILL_ENABLED=true
OPENAUDIO_WAVEFORM_WORKERS=2

# Simulated location for devnet globe
OPENAUDIO_LATITUDE=40.7128
OPENAUDIO_LONGITUDE=-74.0060
